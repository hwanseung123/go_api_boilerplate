services:
    app:
       build: ./app/src
       container_name: white-docker-go
    
    environment:
     - DATABASE_URL: "sqlite:///data/db.sqlit3"
     - DB_NAME: "mydb"
     - DB_PATH=/app/data/production.db    
    ports:
     - "8080:80"
    
	volumes:
     - ./data:/data

    restart: unless-stopped

