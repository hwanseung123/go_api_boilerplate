curl -X POST \
  -H "Content-Type: application/json" \
  -d '{"name": "exmaple"}' \
  http://localhost:8080/insert

curl -X DELETE "http://localhost:8080/delete?name="apple";

curl -X GET "http://localhost:8080/get";

curl -X PUT \
  -H "Content-Type: application/json" \
  -d '{"name" : "eeeeeeestring","id": 15}' \
  http://localhost:8080/put;

