curl -X POST \
  -H "Content-Type: application/json" \
  -d '{"name": "exmaple"}' \
  http://localhost:8080/insert

curl -X DELETE "http://localhost:8080/delete?name="***";

curl -X GET "http://localhost:8080/get";

curl -X PUT \
  -H "Content-Type: application/json" \
  -d '{"id":18 , "name" : "estring"}' \
  http://localhost:8080/put;

