LOAD DATABASE
    FROM sqlite:///home/backend/app/src/demo.db
         INTO postgresql://test:1234@127.0.0.1:5432/mydb

WITH include drop, create tables, create indexes, reset sequences

SET work_mem to '256MB', maintenance_work_mem to '256MB'

CAST type int when (= precision 1) to boolean using tinyint-to-boolean,
     type text to varchar drop default;

